# Server
PORT=3000
NODE_ENV=development


# PostgreSQL  database
DATABASE_URL=postgresql://postgres:your_postgres_password@localhost:5432/sms_gateway?schema=public

# Authentication
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=1d


# SMS billing
SMS_CREDIT_COST_PER_PART=1.00

# Redis / BullMQ queue (optional bonus)
REDIS_URL=redis://localhost:6379/0
SMS_QUEUE_ENABLED=false
SMS_QUEUE_NAME=sms-send
QUEUE_CONCURRENCY=5
QUEUE_ATTEMPTS=3
QUEUE_BACKOFF_MS=5000


# Per-user rate limiting (Redis-backed when REDIS_URL is reachable)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=60
RATE_LIMIT_REDIS_PREFIX=sms:ratelimit

# Delivery-report webhook (HMAC-SHA256)
# Signature = HMAC_SHA256(secret, "<timestamp>.<raw_json_body>")
SMS_WEBHOOK_SECRET=replace_with_a_webhook_hmac_secret
SMS_WEBHOOK_TOLERANCE_SECONDS=300

# Docker Compose host ports
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6380
