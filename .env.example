# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=3000
NODE_ENV=development

# ---------------------------------------------------------------------------
# PostgreSQL (development database)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:your_postgres_password@localhost:5432/sms_gateway?schema=public
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sms_gateway
DB_USER=postgres
DB_PASSWORD=your_postgres_password

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=1d
# Optional: credits granted when a new user registers (default 0.00)
WELCOME_CREDITS=0.00

# ---------------------------------------------------------------------------
# SMS billing
# ---------------------------------------------------------------------------
SMS_CREDIT_COST_PER_PART=1.00

# ---------------------------------------------------------------------------
# Mock provider seed configuration (IMMEDIATE: true)
# Run `npm run seed` to upsert these providers. The seed is idempotent and does
# not touch users, wallets, logs, or attempts.
# ---------------------------------------------------------------------------
SMS_PROVIDER_SEED_JSON=[{"name":"SparrowMock","priority":1,"balance":"1000.00","failureRate":"0.05","isActive":true},{"name":"AakashMock","priority":2,"balance":"500.00","failureRate":"0.15","isActive":true},{"name":"BulkSmsMock","priority":3,"balance":"250.00","failureRate":"0.00","isActive":true}]

# ---------------------------------------------------------------------------
# Redis / BullMQ queue (optional bonus)
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
SMS_QUEUE_ENABLED=false
SMS_QUEUE_NAME=sms-send
QUEUE_CONCURRENCY=5
QUEUE_ATTEMPTS=3
QUEUE_BACKOFF_MS=5000

# ---------------------------------------------------------------------------
# Per-user rate limiting (Redis-backed when REDIS_URL is reachable)
# ---------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=60
RATE_LIMIT_REDIS_PREFIX=sms:ratelimit

# ---------------------------------------------------------------------------
# Delivery-report webhook (HMAC-SHA256)
# Signature = HMAC_SHA256(secret, "<timestamp>.<raw_json_body>")
# ---------------------------------------------------------------------------
SMS_WEBHOOK_SECRET=replace_with_a_webhook_hmac_secret
SMS_WEBHOOK_TOLERANCE_SECONDS=300

# ---------------------------------------------------------------------------
# Automated tests (isolated test database only; NEVER point at development DB)
# ---------------------------------------------------------------------------
TEST_DATABASE_URL=postgresql://postgres:your_postgres_password@localhost:5432/sms_gateway_test?schema=public
TEST_REDIS_URL=redis://localhost:6379/15

# ---------------------------------------------------------------------------
# Docker Compose host ports (avoid clashing with a local PostgreSQL on 5432)
# ---------------------------------------------------------------------------
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6380
